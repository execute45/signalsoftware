# Admin login (change before going live)
NUXT_ADMIN_EMAIL=admin@signalsoftware.de
NUXT_ADMIN_PASSWORD=change-me-now

# Cookie session encryption (min. 32 characters)
NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret-key

# Optional: custom SQLite path (default: .data/signal.db)
# NUXT_DATABASE_URL=/absolute/path/to/signal.db
